{
    "prep_time": 900,
    "flex_event_duration": 7200,
    "market_time": 900,
    "indicator_config": {
        "agent_config": {
            "id": "FlexibilityIndicator",
            "modules": [
                {
                    "module_id": "Ag4Com",
                    "type": "local_broadcast"
                },
                {
                    "module_id": "FlexibilityIndicator",
                    "type": "agentlib_flexquant.flexibility_indicator",
                    "save_results": true,
                    "results_file": "flexibility_indicator.csv",
                    "price_variable": "r_pel",
                    "parameters": [
                        {
                            "name": "prep_time",
                            "value": 900
                        },
                        {
                            "name": "market_time",
                            "value": 900
                        },
                        {
                            "name": "flex_event_duration",
                            "value": 7200
                        },
                        {
                            "name": "time_step",
                            "value": 900
                        },
                        {
                            "name": "prediction_horizon",
                            "value": 48
                        }
                    ],
                    "correct_costs": {
                        "enable_energy_costs_correction": false
                    },
                    "calculate_costs": {
                        "calculate_flex_costs": true,
                        "use_constant_electricity_price": false,
                        "const_electricity_price": 0.0,
                        "use_constant_feed_in_price": true,
                        "const_feed_in_price": 0.0
                    }
                }
            ]
        },
        "name_of_created_file": "indicator.json"
    },
    "market_config": "flex_configs/market.json",
    "baseline_config_generator_data": {
        "power_variable": "P_el",
        "power_unit": "kW",
        "profile_deviation_weight": 100
    },
    "shadow_mpc_config_generator_data": {
        "weights": [
            {
                "name": "s_P", 
                "value": 10
            }
        ],
        "custom_inputs":[
            {   
                "name": "P_el_base",
                "value": 0, 
                "alias":"_P_el_base"
            }
        ],
        "pos_flex": {
            "flex_cost_function": "sum([self.s_T * self.T_slack**2, self.s_P * self.P_el])"
        },
        "neg_flex": {
            "flex_cost_function": "sum([self.s_T * self.T_slack**2, -self.s_P * self.P_el])"
        }
    },
    "flex_files_directory": "created_flex_files",
    "results_directory": "flex_results",
    "delete_files": false,
    "overwrite_files": true
}